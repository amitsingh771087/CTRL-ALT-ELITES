# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/govsync

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Field-level encryption (AES-256-GCM) — MUST be exactly 32 bytes, base64-encoded
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# OTP (stub — plug in an SMS provider like MSG91 / Twilio)
OTP_EXPIRES_MIN=5
OTP_PROVIDER_API_KEY=

# Scheme sync job (cron expression, default: every day at 2am)
SCHEME_SYNC_CRON=0 2 * * *
